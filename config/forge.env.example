# Copy to config/forge.env and source before Forge runs:
#   set -a && source config/forge.env && set +a
#
# Install path used by this machine (Forge 2.0.13 from Card-Forge GitHub release):
#   ~/.local/share/forge/install/

FORGE_JAR="${HOME}/.local/share/forge/install/forge-gui-desktop-2.0.13-jar-with-dependencies.jar"
FORGE_JAVA="/opt/homebrew/opt/openjdk@17/bin/java"
FORGE_DECKS_DIR="${HOME}/Library/Application Support/Forge/decks/constructed"
FORGE_WORK_DIR="${FORGE_DECKS_DIR}"
FORGE_TIMEOUT_SEC=300
